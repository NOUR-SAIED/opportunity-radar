# Gemini is optional locally; the classifier falls back to rules without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Required for hosted Supabase-backed opportunity storage and scheduled scans.
SUPABASE_URL=
SUPABASE_KEY=

# Required by the multi-user Streamlit dashboard.
SUPABASE_ANON_KEY=

# Optional Telegram alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=
